<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen">
  <div class="max-w-7xl mx-auto px-4 py-8">
    
    <!-- Header -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
      <div>
        <h1 class="text-2xl font-bold text-gray-800">Quote Requests</h1>
        <p class="text-sm text-gray-500 mt-1">Total: <%= quotes.length %></p>
      </div>
      <a href="/admin/logout" class="text-sm bg-red-50 text-red-600 hover:bg-red-100 px-4 py-2 rounded-lg transition">
        Logout
      </a>
    </div>

    <% if (quotes.length === 0) { %>
      <div class="bg-white rounded-xl shadow p-10 text-center text-gray-500">
        No quotes submitted yet.
      </div>
    <% } else { %>
      <div class="overflow-x-auto bg-white rounded-xl shadow">
        <table class="min-w-full text-sm">
          <thead class="bg-gray-50 text-left text-gray-600">
            <tr>
              <th class="px-4 py-3 font-medium">Date</th>
              <th class="px-4 py-3 font-medium">Name</th>
              <th class="px-4 py-3 font-medium">Phone</th>
              <th class="px-4 py-3 font-medium">Email</th>
              <th class="px-4 py-3 font-medium">Service</th>
              <th class="px-4 py-3 font-medium">Message</th>
              <th class="px-4 py-3 font-medium">Status</th>
              <th class="px-4 py-3 font-medium">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% quotes.forEach(q => { %>
              <tr class="hover:bg-gray-50">
                <td class="px-4 py-3 whitespace-nowrap"><%= new Date(q.createdAt).toLocaleString() %></td>
                <td class="px-4 py-3 font-medium text-gray-800"><%= q.name %></td>
                <td class="px-4 py-3"><%= q.phone %></td>
                <td class="px-4 py-3"><%= q.email || '-' %></td>
                <td class="px-4 py-3"><%= q.service || '-' %></td>
                <td class="px-4 py-3 max-w-xs">
                  <div class="truncate" title="<%= q.message %>"><%= q.message || '-' %></div>
                </td>
                <td class="px-4 py-3">
                  <% if (q.status === 'New') { %>
                    <span class="px-2.5 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-700">New</span>
                  <% } else if (q.status === 'Contacted') { %>
                    <span class="px-2.5 py-1 rounded-full text-xs font-medium bg-green-100 text-green-700">Contacted</span>
                  <% } else { %>
                    <span class="px-2.5 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-600"><%= q.status %></span>
                  <% } %>
                </td>
                <td class="px-4 py-3 whitespace-nowrap space-x-2">
                  <% if (q.status === 'New') { %>
                    <form action="/admin/quotes/<%= q._id %>/contacted" method="POST" class="inline">
                      <button type="submit" class="text-xs bg-green-50 text-green-700 hover:bg-green-100 px-3 py-1.5 rounded-lg transition">
                        Mark Contacted
                      </button>
                    </form>
                  <% } %>
                  <form action="/admin/quotes/<%= q._id %>/delete" method="POST" class="inline" onsubmit="return confirm('Delete this quote?')">
                    <button type="submit" class="text-xs bg-red-50 text-red-600 hover:bg-red-100 px-3 py-1.5 rounded-lg transition">
                      Delete
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</body>
</html>