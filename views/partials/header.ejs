<header class="bg-white shadow-sm sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3">
        <img src="/images/logo.png" alt="Excalet Integrated Services" class="h-12 w-auto object-contain">
      </a>

      <!-- Desktop Menu -->
      <nav class="hidden md:flex items-center gap-8">
        <a href="/" class="text-gray-700 hover:text-primary font-medium transition">Home</a>
        <a href="/services" class="text-gray-700 hover:text-primary font-medium transition">Services</a>
        <a href="/about" class="text-gray-700 hover:text-primary font-medium transition">About</a>
        <a href="/gallery" class="text-gray-700 hover:text-primary font-medium transition">Gallery</a>
