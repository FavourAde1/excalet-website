<header class="bg-white shadow-sm sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      
      <!-- Logo -->
     <a href="/" class="flex items-center gap-3 shrink-0">
  <img src="/images/logo.png" 
       alt="Excalet Integrated Services" 
       class="h-10 md:h-12 w-auto max-w-[160px] object-contain">
</a>

      <!-- Desktop Menu -->
      <nav class="hidden md:flex items-center gap-8">
        <a href="/" class="text-gray-700 hover:text-green-700 font-medium transition">Home</a>

        <!-- Services Dropdown -->
        <div class="relative group">
          <button class="text-gray-700 hover:text-green-700 font-medium transition flex items-center gap-1">
            Services
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div class="absolute left-0 mt-2 w-64 bg-white shadow-lg rounded-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
            <a href="/services/residential" class="block px-5 py-3 text-sm text-gray-700 hover:bg-green-50 hover:text-green-700">Residential Cleaning & Pest Control</a>
            <a href="/services/commercial" class="block px-5 py-3 text-sm text-gray-700 hover:bg-green-50 hover:text-green-700">Commercial Cleaning & Pest Management</a>
            <a href="/services/facility-management" class="block px-5 py-3 text-sm text-gray-700 hover:bg-green-50 hover:text-green-700">Facility Management</a>
            <a href="/services/environmental" class="block px-5 py-3 text-sm text-gray-700 hover:bg-green-50 hover:text-green-700">Environmental & Sanitation</a>
          </div>
        </div>

        <!-- Company Dropdown -->
        <div class="relative group">
          <button class="text-gray-700 hover:text-green-700 font-medium transition flex items-center gap-1">
            Company
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div class="absolute left-0 mt-2 w-48 bg-white shadow-lg rounded-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
            <a href="/about" class="block px-5 py-3 text-sm text-gray-700 hover:bg-green-50 hover:text-green-700">About Us</a>
            <a href="/industries" class="block px-5 py-3 text-sm text-gray-700 hover:bg-green-50 hover:text-green-700">Industries We Serve</a>
            <a href="/gallery" class="block px-5 py-3 text-sm text-gray-700 hover:bg-green-50 hover:text-green-700">Gallery</a>
            <a href="/faq" class="block px-5 py-3 text-sm text-gray-700 hover:bg-green-50 hover:text-green-700">FAQ</a>
            <a href="/contact" class="block px-5 py-3 text-sm text-gray-700 hover:bg-green-50 hover:text-green-700">Contact</a>
          </div>
        </div>

        <a href="/contact" class="text-gray-700 hover:text-green-700 font-medium transition">Contact</a>

        <a href="/contact" 
           class="bg-green-600 hover:bg-green-700 text-white px-6 py-2.5 rounded-lg font-medium transition shadow-sm">
          Free Inspection
        </a>
      </nav>

      <!-- Mobile button -->
      <button id="mobile-menu-btn" class="md:hidden p-2 text-gray-700">
        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>
  </div>
</header>